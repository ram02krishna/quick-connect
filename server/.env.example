# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Exact origin of the web client (no trailing slash)
CLIENT_URL=http://localhost:3000

# ─── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quickconnect?schema=public"

# ─── Upstash Redis (OTPs, presence, rate counters) ────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── Secrets (use long random strings, at least 32 characters) ────────────────
# NOTE: message/email encryption keys are derived from JWT_SECRET.
# Rotating it makes previously stored messages and emails unreadable.
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
COOKIE_SECRET=change_me_to_another_long_random_string_32_chars

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_FROM="QuickConnect <onboarding@resend.dev>"

# ─── Cloudinary (media uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Rate limiting (general API limiter, per IP) ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
