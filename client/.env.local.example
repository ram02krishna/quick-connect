# Client Environment Variables
# Copy this file to .env.local and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# URL of the QuickConnect backend API (no trailing slash)
# Local:      http://localhost:5000/api
# Production: https://your-server.railway.app/api   (or Render etc.)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket base URL — same host as the API but WITHOUT the /api path
# Local:      http://localhost:5000
# Production: https://your-server.railway.app
NEXT_PUBLIC_WS_URL=http://localhost:5000

# ── Optional: TURN relay for calls ───────────────────────────────────────────
# STUN alone can't connect people behind strict NATs (common on mobile data).
# Add a TURN server (e.g. coturn, or a hosted provider) to make those calls work.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
